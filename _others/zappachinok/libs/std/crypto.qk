## Crypto Library

import libs.zappachinok.libs.std.io
import libs.zappachinok.libs.std.fs

class Crypto {
    static fn MD5(str) {
        # Use Python to calculate the MD5 hash of a string
        script = '''
import hashlib

print(hashlib.md5("''' + str + '''".encode()).hexdigest())
'''
        fs.WriteToFile("./crypto_md5.py", script)
        result = `python3 ./crypto_md5.py`
        `rm ./crypto_md5.py`
        return result
    }

    static fn SHA256(str) {
        # Use Python to calculate the SHA256 hash of a string
        script = '''
import hashlib

print(hashlib.sha256("''' + str + '''".encode()).hexdigest())
'''
        fs.WriteToFile("./crypto_sha256.py", script)
        result = `python3 ./crypto_sha256.py`
        `rm ./crypto_sha256.py`
        return result
    }

    static fn Random(min, max) {
        # Use Python to generate a random number
        script = '''
import random

print(random.randint(''' + min + ''', ''' + max + '''))
'''
        fs.WriteToFile("./crypto_random.py", script)
        result = `python3 ./crypto_random.py`
        `rm ./crypto_random.py`
        return result
    }

    static fn SHA1(str) {
        # Use Python to calculate the SHA1 hash of a string
        script = '''
import hashlib

print(hashlib.sha1("''' + str + '''".encode()).hexdigest())
'''
        fs.WriteToFile("./crypto_sha1.py", script)
        result = `python3 ./crypto_sha1.py`
        `rm ./crypto_sha1.py`
        return result
    }

    static fn SHA512(str) {
        # Use Python to calculate the SHA512 hash of a string
        script = '''
import hashlib

print(hashlib.sha512("''' + str + '''".encode()).hexdigest())
'''
        fs.WriteToFile("./crypto_sha512.py", script)
        result = `python3 ./crypto_sha512.py`
        `rm ./crypto_sha512.py`
        return result
    }

    static fn AESEncrypt(data, key) {
        # Use Python to encrypt data with AES
        script = '''
from Crypto.Cipher import AES
from Crypto.Random import get_random_bytes
import base64

def encrypt(data, key):
    key = key.encode('utf-8')
    data = data.encode('utf-8')
    iv = get_random_bytes(AES.block_size)
    cipher = AES.new(key, AES.MODE_GCM, iv)
    ciphertext, tag = cipher.encrypt_and_digest(data)
    return base64.b64encode(iv + ciphertext + tag).decode('utf-8')

print(encrypt("''' + data + '''", "''' + key + '''"))
'''
        fs.WriteToFile("./crypto_aes_encrypt.py", script)
        result = `python3 ./crypto_aes_encrypt.py`
        `rm ./crypto_aes_encrypt.py`
        return result
    }

    static fn AESDecrypt(data, key) {
        # Use Python to decrypt data with AES
        script = '''
from Crypto.Cipher import AES
from Crypto.Random import get_random_bytes
import base64

def decrypt(data, key):
    key = key.encode('utf-8')
    data = base64.b64decode(data.encode('utf-8'))
    iv = data[:AES.block_size]
    tag = data[-AES.block_size:]
    ciphertext = data[AES.block_size:-AES.block_size]
    cipher = AES.new(key, AES.MODE_GCM, iv)
    plaintext = cipher.decrypt_and_verify(ciphertext, tag)
    return plaintext.decode('utf-8')

print(decrypt("''' + data + '''", "''' + key + '''"))
'''
        fs.WriteToFile("./crypto_aes_decrypt.py", script)
        result = `python3 ./crypto_aes_decrypt.py`
        `rm ./crypto_aes_decrypt.py`
        return result
    }

   static fn FernetEncrypt(data, key) {
        # Use Python to encrypt data with Fernet
        script = '''
from cryptography.fernet import Fernet
import base64

def encrypt(data, key):
    key = key.encode('utf-8')
    data = data.encode('utf-8')
    f = Fernet(key)
    encrypted = f.encrypt(data)
    return base64.b64encode(encrypted).decode('utf-8')

print(encrypt("''' + data + '''", "''' + key + '''"))
'''
        fs.WriteToFile("./crypto_fernet_encrypt.py", script)
        result = `python3 ./crypto_fernet_encrypt.py`
        `rm ./crypto_fernet_encrypt.py`
        return result
    }

   static fn FernetDecrypt(data, key) {
        # Use Python to decrypt data with Fernet
        script = '''
from cryptography.fernet import Fernet
import base64

def decrypt(data, key):
    key = key.encode('utf-8')
    data = base64.b64decode(data.encode('utf-8'))
    f = Fernet(key)
    decrypted = f.decrypt(data)
    return decrypted.decode('utf-8')

print(decrypt("''' + data + '''", "''' + key + '''"))
'''
        fs.WriteToFile("./crypto_fernet_decrypt.py", script)
        result = `python3 ./crypto_fernet_decrypt.py`
        `rm ./crypto_fernet_decrypt.py`
        return result
    }

   static fn GeneratePassword(length) {
        # Use Python to generate a random password
        script = '''
import secrets
import string

def generate_password(length):
    alphabet = string.ascii_letters + string.digits + string.punctuation
    password = ''.join(secrets.choice(alphabet) for i in range(length))
    return password

print(generate_password(''' + length + '''))
'''
        fs.WriteToFile("./crypto_generate_password.py", script)
        result = `python3 ./crypto_generate_password.py`
        `rm ./crypto_generate_password.py`
        return result
    }

   static fn PBKDF2(password, salt, iterations) {
        # Use Python to generate a key using PBKDF2
        script = '''
import hashlib
import base64

def pbkdf2(password, salt, iterations=100000):
    dk = hashlib.pbkdf2_hmac('sha256', password.encode('utf-8'), salt.encode('utf-8'), iterations)
    return base64.b64encode(dk).decode('utf-8')

print(pbkdf2("''' + password + '''", "''' + salt + '''", ''' + iterations + '''))
'''
        fs.WriteToFile("./crypto_pbkdf2.py", script)
        result = `python3 ./crypto_pbkdf2.py`
        `rm ./crypto_pbkdf2.py`
        return result
    }
}
