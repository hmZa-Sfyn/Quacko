## Array Library

import libs.zappachinok.libs.std.io
import libs.zappachinok.libs.std.fs

class Array {
    static fn Length(arr) {
        # Use Python to get the length of an array
        script = '''
print(len(''' + arr + '''))
'''
        fs.WriteToFile("./array_length.py", script)
        result = `python3 ./array_length.py`
        `rm ./array_length.py`
        return result
    }

    static fn Append(arr, item) {
        # Use Python to append an item to an array
        script = '''
arr = ''' + arr + '''
arr.append(''' + item + ''')
print(arr)
'''
        fs.WriteToFile("./array_append.py", script)
        result = `python3 ./array_append.py`
        `rm ./array_append.py`
        return result
    }

    static fn Pop(arr) {
        # Use Python to remove and return the last element of an array
        script = '''
arr = ''' + arr + '''
try:
    print(arr.pop())
except IndexError:
    print("Error: Array is empty")
'''
        fs.WriteToFile("./array_pop.py", script)
        result = `python3 ./array_pop.py`
        `rm ./array_pop.py`
        return result
    }

    static fn Insert(arr, index, item) {
        # Use Python to insert an item at a specific index in an array
        script = '''
arr = ''' + arr + '''
arr.insert(''' + index + ''', ''' + item + ''')
print(arr)
'''
        fs.WriteToFile("./array_insert.py", script)
        result = `python3 ./array_insert.py`
        `rm ./array_insert.py`
        return result
    }

    static fn Remove(arr, item) {
        # Use Python to remove the first occurrence of an item from an array
        script = '''
arr = ''' + arr + '''
try:
    arr.remove(''' + item + ''')
    print(arr)
except ValueError:
    print("Error: Item not found in array")
'''
        fs.WriteToFile("./array_remove.py", script)
        result = `python3 ./array_remove.py`
        `rm ./array_remove.py`
        return result
    }

    static fn RemoveAt(arr, index) {
        # Use Python to remove an item at a specific index from an array
        script = '''
arr = ''' + arr + '''
try:
    del arr[''' + index + ''']
    print(arr)
except IndexError:
    print("Error: Index out of range")
'''
        fs.WriteToFile("./array_remove_at.py", script)
        result = `python3 ./array_remove_at.py`
        `rm ./array_remove_at.py`
        return result
    }

    static fn IndexOf(arr, item) {
        # Use Python to find the index of an item in an array
        script = '''
arr = ''' + arr + '''
try:
    print(arr.index(''' + item + '''))
except ValueError:
    print("Error: Item not found in array")
'''
        fs.WriteToFile("./array_index_of.py", script)
        result = `python3 ./array_index_of.py`
        `rm ./array_index_of.py`
        return result
    }

    static fn Contains(arr, item) {
        # Use Python to check if an array contains an item
        script = '''
arr = ''' + arr + '''
print(''' + item + ''' in arr)
'''
        fs.WriteToFile("./array_contains.py", script)
        result = `python3 ./array_contains.py`
        `rm ./array_contains.py`
        return result
    }

    static fn Sort(arr) {
        # Use Python to sort an array
        script = '''
arr = ''' + arr + '''
arr.sort()
print(arr)
'''
        fs.WriteToFile("./array_sort.py", script)
        result = `python3 ./array_sort.py`
        `rm ./array_sort.py`
        return result
    }

    static fn Reverse(arr) {
        # Use Python to reverse an array
        script = '''
arr = ''' + arr + '''
arr.reverse()
print(arr)
'''
        fs.WriteToFile("./array_reverse.py", script)
        result = `python3 ./array_reverse.py`
        `rm ./array_reverse.py`
        return result
    }

    static fn Clear(arr) {
        # Use Python to clear an array
        script = '''
arr = ''' + arr + '''
arr.clear()
print(arr)
'''
        fs.WriteToFile("./array_clear.py", script)
        result = `python3 ./array_clear.py`
        `rm ./array_clear.py`
        return result
    }

    static fn Copy(arr) {
        # Use Python to copy an array
        script = '''
import copy
arr = ''' + arr + '''
print(copy.copy(arr))
'''
        fs.WriteToFile("./array_copy.py", script)
        result = `python3 ./array_copy.py`
        `rm ./array_copy.py`
        return result
    }

    static fn Extend(arr, arr2) {
        # Use Python to extend an array with another array
        script = '''
arr = ''' + arr + '''
arr2 = ''' + arr2 + '''
arr.extend(arr2)
print(arr)
'''
        fs.WriteToFile("./array_extend.py", script)
        result = `python3 ./array_extend.py`
        `rm ./array_extend.py`
        return result
    }

    static fn Count(arr, item) {
        # Use Python to count the occurrences of an item in an array
        script = '''
arr = ''' + arr + '''
print(arr.count(''' + item + '''))
'''
        fs.WriteToFile("./array_count.py", script)
        result = `python3 ./array_count.py`
        `rm ./array_count.py`
        return result
    }

    static fn IsEmpty(arr) {
        # Use Python to check if an array is empty
        script = '''
arr = ''' + arr + '''
print(len(arr) == 0)
'''
        fs.WriteToFile("./array_is_empty.py", script)
        result = `python3 ./array_is_empty.py`
        `rm ./array_is_empty.py`
        return result
    }

    static fn GetRange(arr, start, end) {
        # Use Python to get a range of elements from an array
        script = '''
arr = ''' + arr + '''
print(arr[start:end])
'''
        fs.WriteToFile("./array_get_range.py", script)
        result = `python3 ./array_get_range.py`
        `rm ./array_get_range.py`
        return result
    }
}
