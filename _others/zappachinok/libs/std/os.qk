## OS Library

import libs.zappachinok.libs.std.io
import libs.zappachinok.libs.std.fs

class OS {
    static fn Remove(path) {
        # Use Python to remove a file or directory
        script = '''
import os

try:
    os.remove("''' + path + '''")
    print("File removed successfully")
except Exception as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./os_remove.py", script)
        result = `python3 ./os_remove.py`
        `rm ./os_remove.py`
        return result
    }

    static fn Exit(code) {
        # Use Python to exit the program with a specified code
        script = '''
import os
import sys

sys.exit(''' + code + ''')
'''
        fs.WriteToFile("./os_exit.py", script)
        result = `python3 ./os_exit.py`
        `rm ./os_exit.py`
        return result
    }

    static fn Mkdir(path) {
        # Use Python to create a directory
        script = '''
import os

try:
    os.mkdir("''' + path + '''")
    print("Directory created successfully")
except Exception as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./os_mkdir.py", script)
        result = `python3 ./os_mkdir.py`
        `rm ./os_mkdir.py`
        return result
    }

    static fn Exists(path) {
        # Use Python to check if a file or directory exists
        script = '''
import os

print(os.path.exists("''' + path + '''"))
'''
        fs.WriteToFile("./os_exists.py", script)
        result = `python3 ./os_exists.py`
        `rm ./os_exists.py`
        return result
    }

    static fn Getenv(name) {
        # Use Python to get an environment variable
        script = '''
import os

print(os.getenv("''' + name + '''"))
'''
        fs.WriteToFile("./os_getenv.py", script)
        result = `python3 ./os_getenv.py`
        `rm ./os_getenv.py`
        return result
    }

    static fn Listdir(path) {
        # Use Python to list directory contents
        script = '''
import os

print(os.listdir("''' + path + '''"))
'''
        fs.WriteToFile("./os_listdir.py", script)
        result = `python3 ./os_listdir.py`
        `rm ./os_listdir.py`
        return result
    }

    static fn Rename(old_path, new_path) {
        # Use Python to rename a file or directory
        script = '''
import os

try:
    os.rename("''' + old_path + '''", "''' + new_path + '''")
    print("File renamed successfully")
except Exception as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./os_rename.py", script)
        result = `python3 ./os_rename.py`
        `rm ./os_rename.py`
        return result
    }

    static fn Symlink(src, dst) {
        # Use Python to create a symbolic link
        script = '''
import os

try:
    os.symlink("''' + src + '''", "''' + dst + '''")
    print("Symbolic link created successfully")
except Exception as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./os_symlink.py", script)
        result = `python3 ./os_symlink.py`
        `rm ./os_symlink.py`
        return result
    }

    static fn Getsize(path) {
        # Use Python to get the size of a file
        script = '''
import os

print(os.path.getsize("''' + path + '''"))
'''
        fs.WriteToFile("./os_getsize.py", script)
        result = `python3 ./os_getsize.py`
        `rm ./os_getsize.py`
        return result
    }

    static fn Getmtime(path) {
        # Use Python to get the last modification time of a file
        script = '''
import os
import time

print(time.ctime(os.path.getmtime("''' + path + '''")))
'''
        fs.WriteToFile("./os_getmtime.py", script)
        result = `python3 ./os_getmtime.py`
        `rm ./os_getmtime.py`
        return result
    }

    static fn Chmod(path, mode) {
        # Use Python to change file permissions
        script = '''
import os

try:
    os.chmod("''' + path + '''", ''' + mode + ''')
    print("Permissions changed successfully")
except Exception as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./os_chmod.py", script)
        result = `python3 ./os_chmod.py`
        `rm ./os_chmod.py`
        return result
    }

    static fn Getcwd() {
        # Use Python to get the current working directory
        script = '''
import os

print(os.getcwd())
'''
        fs.WriteToFile("./os_getcwd.py", script)
        result = `python3 ./os_getcwd.py`
        `rm ./os_getcwd.py`
        return result
    }
}
