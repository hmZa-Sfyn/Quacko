## HTTP Library

import libs.zappachinok.libs.std.io
import libs.zappachinok.libs.std.fs

class HTTP {
    static fn Get(url) {
        # Use Python to make the HTTP GET request
        script = '''
import requests

try:
    response = requests.get("''' + url + '''")
    response.raise_for_status()  # Raise HTTPError for bad responses (4xx or 5xx)
    print(response.text)
except requests.exceptions.RequestException as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./http_get.py", script)
        result = `python3 ./http_get.py`
        `rm ./http_get.py`
        return result
    }

    static fn Post(url, data) {
        # Use Python to make the HTTP POST request
        script = '''
import requests

try:
    response = requests.post("''' + url + '''", data=''' + data + ''')
    response.raise_for_status()  # Raise HTTPError for bad responses (4xx or 5xx)
    print(response.text)
except requests.exceptions.RequestException as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./http_post.py", script)
        result = `python3 ./http_post.py`
        `rm ./http_post.py`
        return result
    }

    static fn SetHeader(url, header, value) {
        # Use Python to set a header in the HTTP request
        script = '''
import requests

try:
    headers = {"''' + header + '''": "''' + value + '''"}
    response = requests.get("''' + url + '''", headers=headers)
    response.raise_for_status()
    print(response.text)
except requests.exceptions.RequestException as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./http_set_header.py", script)
        result = `python3 ./http_set_header.py`
        `rm ./http_set_header.py`
        return result
    }

    static fn SetTimeout(url, timeout) {
        # Use Python to set a timeout for the HTTP request
        script = '''
import requests

try:
    response = requests.get("''' + url + '''", timeout=''' + timeout + ''')
    response.raise_for_status()
    print(response.text)
except requests.exceptions.RequestException as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./http_set_timeout.py", script)
        result = `python3 ./http_set_timeout.py`
        `rm ./http_set_timeout.py`
        return result
    }

    static fn HandleRedirects(url, allow_redirects) {
        # Use Python to handle redirects in the HTTP request
        script = '''
