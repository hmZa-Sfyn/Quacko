    static fn GetCookies(url) {
        # Use Python to get the cookies from the HTTP response
        script = '''
import requests

try:
    response = requests.get("''' + url + '''")
    print(response.cookies.get_dict())
except requests.exceptions.RequestException as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./http_get_cookies.py", script)
        result = `python3 ./http_get_cookies.py`
        `rm ./http_get_cookies.py`
        return result
    }

    static fn SetCookies(url, cookies) {
        # Use Python to set cookies for the HTTP request
        script = '''
import requests

try:
    response = requests.get("''' + url + '''", cookies=''' + cookies + ''')
    response.raise_for_status()
    print(response.text)
except requests.exceptions.RequestException as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./http_set_cookies.py", script)
        result = `python3 ./http_set_cookies.py`
        `rm ./http_set_cookies.py`
        return result
    }

    static fn DownloadFile(url, filepath) {
        # Use Python to download a file from the HTTP response
        script = '''
import requests

try:
    response = requests.get("''' + url + '''", stream=True)
    response.raise_for_status()
    with open("''' + filepath + '''", 'wb') as f:
        for chunk in response.iter_content(chunk_size=8192):
            f.write(chunk)
    print("File downloaded successfully")
except requests.exceptions.RequestException as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./http_download_file.py", script)
        result = `python3 ./http_download_file.py`
        `rm ./http_download_file.py`
        return result
    }
}
