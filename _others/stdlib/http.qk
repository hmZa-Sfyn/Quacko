    print(response.text)
except requests.exceptions.RequestException as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./http_handle_redirects.py", script)
        result = `python3 ./http_handle_redirects.py`
        `rm ./http_handle_redirects.py`
        return result
    }

    static fn GetStatusCode(url) {
        # Use Python to get the status code of the HTTP response
        script = '''
import requests

try:
    response = requests.get("''' + url + '''")
    print(response.status_code)
except requests.exceptions.RequestException as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./http_get_status_code.py", script)
        result = `python3 ./http_get_status_code.py`
        `rm ./http_get_status_code.py`
        return result
    }

    static fn GetHeaders(url) {
         # Use Python to get the headers of the HTTP response
        script = '''
import requests

try:
    response = requests.get("''' + url + '''")
