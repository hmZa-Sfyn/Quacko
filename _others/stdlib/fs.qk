
fn ReadFile(filename) {
	file = newFile(filename, "r")
	if (file == nil) {
		println("opening ", filename, "for reading failed, error:", file.message())
		return false
	}
	defer file.close()

    filecontent = ""

    while (<$file>) { //same as above 'while' loop
		filecontent = filecontent + "\n" + ($_)
	}
	
	return filecontent
}
fn WriteToFile(filename,content) {
	file = newFile(filename, "w+")
	if (file == nil) {
		println("opening ", filename, "for writing failed, error:", file.message())
		return false
	}
	defer file.close()

	file.writeLine(content)

	return true
}


class Dir {
    static fn ListChildern(dir_path) {
        fileX = newFile("./fs_dirlist.py","w")

        if (fileX == nil) {
            println("opening ", filename, "for reading failed, error:", file.message())
            return false
        }

        fileX.writeLine("import os")
        fileX.writeLine("all_stuff = os.listdir(\""+dir_path+"\")")
        fileX.writeLine("with open(\"./data.dat\",\"w\") as File:")
        fileX.writeLine("    y = \"\"")
        fileX.writeLine("    for xx in all_stuff:")
        fileX.writeLine("        y = y + \" \" + xx")
        fileX.writeLine("    File.write(str(y))")

        out = `python3 ./fs_dirlist.py {input_string}`
        #print(out)
        filename = "./data.dat"
        file = newFile(filename, "r")
        if (file == nil) {
            println("opening ", filename, "for reading failed, error:", file.message())
            return false
        }

        _XX = ""

        while (<$file>) { //same as above 'while' loop
            _XX = _XX + ($_)
        }

        out = `rm ./data.dat`
        out = `rm ./fs_dirlist.py`
        return (_XX)
    }

    static fn Isfile(item) {
       fileX = newFile("./fs_dirlist.py","w")

        if (fileX == nil) {
            println("opening ", filename, " for reading failed, error:", file.message())
            return false
        }

        fileX.writeLine("import os")
        fileX.writeLine("all_stuff = os.path.isfile(\""+item+"\")")
        fileX.writeLine("with open(\"./data.dat\",\"w\") as File:")
        fileX.writeLine("    File.write(str(all_stuff))")

        out = `python3 ./fs_dirlist.py {input_string}`
        #print(out)
        filename = "./data.dat"
        file = newFile(filename, "r")
        if (file == nil) {
            println("opening ", filename, " for reading failed, error:", file.message())
            return false
        }

        _XX = ""

        while (<$file>) { //same as above 'while' loop
            _XX = _XX + ($_)
        }

        out = `rm ./data.dat`
        out = `rm ./fs_dirlist.py`
        if (_XX == "True") {
            return true
        }
        else {return false}
    }

    static fn Isdir(item) {
       fileX = newFile("./fs_dirlist.py","w")

        if (fileX == nil) {
            println("opening ", filename, " for reading failed, error:", file.message())
            return false
        }

        fileX.writeLine("import os")
        fileX.writeLine("all_stuff = os.path.isfile(\""+item+"\")")
        fileX.writeLine("with open(\"./data.dat\",\"w\") as File:")
        fileX.writeLine("    File.write(str(all_stuff))")

        out = `python3 ./fs_dirlist.py {input_string}`
        #print(out)
        filename = "./data.dat"
        file = newFile(filename, "r")
        if (file == nil) {
            println("opening ", filename, " for reading failed, error:", file.message())
            return false
        }

        _XX = ""

        while (<$file>) { //same as above 'while' loop
            _XX = _XX + ($_)
        }

        out = `rm ./data.dat`
        out = `rm ./fs_dirlist.py`

        if (_XX == "True") {
            return false
        }
        else {return true}
        
    }
    
}

