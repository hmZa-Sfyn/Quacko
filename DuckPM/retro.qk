// GET request
fn Get(url) {
  
  response = http.get(url)
  
  if (response.statusCode == 200) {
    return response.body.toJson()
  } else {
    println("Error: " + response.statusCode)
    return nil
  }
}

GetZ = fn(url) {
	let response = http.get(url)
	defer response.closeBody()
	let body = response.readAll()
	println(body)
}

// POST request with JSON body
fn Post(url,headers,payload) {

  // Convert data to JSON
  jsonData = json.marshal(payload)
  
  if (headers == {}) {
  // Set headers
        headers = {
            "Content-Type": "application/json"
        }
  }
  
  // Make POST request
  response = http.post(url, payload, headers)
  
  if (response.statusCode == 201) {
    return response.body.toJson()
  } else {
    println("Error: " + response.statusCode + ", " + response.body)
    return nil
  }
}

println(GetZ("http://localhost:8080/"))