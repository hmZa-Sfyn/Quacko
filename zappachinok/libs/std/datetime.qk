class Datetime {
    static fn Now() {
        __DateTimeNow = `python3 -c "import datetime; print(str(datetime.datetime.now()))"`
        return __DateTimeNow
    }

    static fn Unix() {
        __DateTimeNow = `python3 -c "import time; print(str(time.time()))"`
        return __DateTimeNow
    } 

    ##more

    static fn cDate() {
        __DateTimeNow = `python3 -c "import datetime; x = datetime.datetime.now(); print(x.strftime('%Y-%m-%d'))"`
        return __DateTimeNow
    }

    static fn cTime() {
        __DateTimeNow = `python3 -c "import datetime; x = datetime.datetime.now(); print(x.strftime('%H:%M:%S'))"`
        return __DateTimeNow
    } 
}

class Datetime (MeasureUnixDistance) {
    static fn MeasureUnixDistance(from_time,to_time)
    {
        __DateTimeNow = `python3 -c "print($to_time - $from_time)"`
        return __DateTimeNow
    }
}

