import libs.std.datetime

#import libs.std.colorsX

class Console {

    let Bool = true
    static property IsOutputAllowed {
        get { return Bool}
        set {
            if (value == true) { Bool = value }
            elif (value == false) { Bool = value}
            else {
                println("error at Std.IO :: Console.Output :: IsOutputAllowed (property can only be 'true' or 'false')")
            }
        }
    }

    static fn Println(output_string) {
        if (Bool == true)
        {
            println(output_string)
        }
    }

    static fn Print(output_string) {
        if (Bool == true)
        {
            print(output_string)
        }
    }

    static fn Log(output_string) {
        if (Bool == true)
        {
            println(datetime.Datetime.Now() + " >> " + output_string)
        }
    }
}

class Console (Input) {
    static fn Input(input_string) {
        print(input_string)
        fileX = newFile("./io.py","w")

        if (fileX == nil) {
            println("opening ", filename, "for reading failed, error:", file.message())
            return false
        }

        fileX.writeLine("import sys")
        fileX.writeLine("UInput = input()")
        fileX.writeLine("with open(\"./data.dat\",\"w\") as File:")
        fileX.writeLine("    File.write(UInput)")

        out = `python3 ./io.py {input_string}`
        #print(out)
        filename = "./data.dat"
        file = newFile(filename, "r")
        if (file == nil) {
            println("opening ", filename, "for reading failed, error:", file.message())
            return false
        }
        

        //while (l = <$file>) { //same as below
        //while ((l = file.readLine()) != nil) {
        //	println(l)
        //}

        _XX = ""

        while (<$file>) { //same as above 'while' loop
            _XX = _XX + ($_)
        }

        out = `rm ./data.dat`
        out = `rm ./io.py`
        return (_XX)
    }
}

class Console (Fmt) {
    static fn Fmt(out_out_string, vars) {
        let result = out_out_string
        let index = 1
        for item in vars {
            let placeholder = "$" + str(index)
            result = result.replace(placeholder, str(item))
            index = index + 1
        }
        return result
    }
}
