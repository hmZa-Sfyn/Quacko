## JSON Library

import libs.std.io
import libs.std.fs

class JSON {
    static fn Encode(data) {
        # Use Python to encode JSON data
        script = '''
import json

try:
    print(json.dumps(''' + data + '''))
except Exception as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./json_encode.py", script)
        result = `python3 ./json_encode.py`
        `rm ./json_encode.py`
        return result
    }

    static fn Decode(json_string) {
        # Use Python to decode JSON data
        script = '''
import json

try:
    print(json.loads("''' + json_string + '''"))
except Exception as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./json_decode.py", script)
        result = `python3 ./json_decode.py`
        `rm ./json_decode.py`
        return result
    }

    static fn Validate(json_string) {
        # Use Python to validate JSON data
        script = '''
import json

try:
    json.loads("''' + json_string + '''")
    print("True")
except ValueError as e:
    print("False")
'''
        fs.WriteToFile("./json_validate.py", script)
        result = `python3 ./json_validate.py`
        `rm ./json_validate.py`
        return result
    }

    static fn Format(json_string) {
        # Use Python to format JSON data
        script = '''
import json

try:
    data = json.loads("''' + json_string + '''")
    print(json.dumps(data, indent=4))
except ValueError as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./json_format.py", script)
        result = `python3 ./json_format.py`
        `rm ./json_format.py`
        return result
    }

    static fn Compact(json_string) {
        # Use Python to compact JSON data
        script = '''
import json

try:
    data = json.loads("''' + json_string + '''")
    print(json.dumps(data, separators=(',', ':')))
except ValueError as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./json_compact.py", script)
        result = `python3 ./json_compact.py`
        `rm ./json_compact.py`
        return result
    }

    static fn GetValue(json_string, key) {
        # Use Python to get a value from JSON data
        script = '''
import json

try:
    data = json.loads("''' + json_string + '''")
    print(data["''' + key + '''"])
except (ValueError, KeyError) as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./json_get_value.py", script)
        result = `python3 ./json_get_value.py`
        `rm ./json_get_value.py`
        return result
    }

    static fn HasKey(json_string, key) {
        # Use Python to check if a key exists in JSON data
        script = '''
import json

try:
    data = json.loads("''' + json_string + '''")
    if "''' + key + '''" in data:
        print("True")
    else:
        print("False")
except ValueError as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./json_has_key.py", script)
        result = `python3 ./json_has_key.py`
        `rm ./json_has_key.py`
        return result
    }

    static fn GetType(json_string, key) {
        # Use Python to get the type of a value in JSON data
        script = '''
import json

try:
    data = json.loads("''' + json_string + '''")
    print(type(data["''' + key + '''"]).__name__)
except (ValueError, KeyError) as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./json_get_type.py", script)
        result = `python3 ./json_get_type.py`
        `rm ./json_get_type.py`
        return result
    }

    static fn GetKeys(json_string) {
        # Use Python to get all keys from JSON data
        script = '''
import json

try:
    data = json.loads("''' + json_string + '''")
    print(list(data.keys()))
except ValueError as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./json_get_keys.py", script)
        result = `python3 ./json_get_keys.py`
        `rm ./json_get_keys.py`
        return result
    }

    static fn GetValues(json_string) {
        # Use Python to get all values from JSON data
        script = '''
import json

try:
    data = json.loads("''' + json_string + '''")
    print(list(data.values()))
except ValueError as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./json_get_values.py", script)
        result = `python3 ./json_get_values.py`
        `rm ./json_get_values.py`
        return result
    }

    static fn Merge(json_string1, json_string2) {
        # Use Python to merge two JSON objects
        script = '''
import json

try:
    data1 = json.loads("''' + json_string1 + '''")
    data2 = json.loads("''' + json_string2 + '''")
    data1.update(data2)
    print(data1)
except ValueError as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./json_merge.py", script)
        result = `python3 ./json_merge.py`
        `rm ./json_merge.py`
        return result
    }

    static fn Filter(json_string, key) {
        # Use Python to filter JSON data by a key
        script = '''
import json

try:
    data = json.loads("''' + json_string + '''")
    print({k: v for k, v in data.items() if k == "''' + key + '''"})
except ValueError as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./json_filter.py", script)
        result = `python3 ./json_filter.py`
        `rm ./json_filter.py`
        return result
    }

    static fn Sort(json_string, key) {
        # Use Python to sort JSON data by a key
        script = '''
import json

try:
    data = json.loads("''' + json_string + '''")
    print(sorted(data.items(), key=lambda x: x[0]))
except ValueError as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./json_sort.py", script)
        result = `python3 ./json_sort.py`
        `rm ./json_sort.py`
        return result
    }

    static fn RemoveKey(json_string, key) {
        # Use Python to remove a key from JSON data
        script = '''
import json

try:
    data = json.loads("''' + json_string + '''")
    del data["''' + key + '''"]
    print(data)
except (ValueError, KeyError) as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./json_remove_key.py", script)
        result = `python3 ./json_remove_key.py`
        `rm ./json_remove_key.py`
        return result
    }

    static fn Copy(json_string) {
        # Use Python to create a copy of JSON data
        script = '''
import json
import copy

try:
    data = json.loads("''' + json_string + '''")
    print(copy.deepcopy(data))
except ValueError as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./json_copy.py", script)
        result = `python3 ./json_copy.py`
        `rm ./json_copy.py`
        return result
    }
}
