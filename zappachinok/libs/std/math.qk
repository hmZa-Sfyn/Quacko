        fs.WriteToFile("./math_floor.py", script)
        result = `python3 ./math_floor.py`
        `rm ./math_floor.py`
        return result
    }

    static fn Round(num) {
        # Use Python to round a number to the nearest integer
        script = '''
print(round(''' + num + '''))
'''
        fs.WriteToFile("./math_round.py", script)
        result = `python3 ./math_round.py`
        `rm ./math_round.py`
        return result
    }

    static fn Fabs(num) {
        # Use Python to calculate the absolute value of a float number
        script = '''
