print(math.acos(''' + num + '''))
'''
        fs.WriteToFile("./math_acos.py", script)
        result = `python3 ./math_acos.py`
        `rm ./math_acos.py`
        return result
    }

    static fn Atan(num) {
        # Use Python to calculate the arctangent of a number
        script = '''
import math

print(math.atan(''' + num + '''))
'''
        fs.WriteToFile("./math_atan.py", script)
        result = `python3 ./math_atan.py`
        `rm ./math_atan.py`
        return result
    }

    static fn Log(num) {
        # Use Python to calculate the natural logarithm of a number
        script = '''
import math

print(math.log(''' + num + '''))
'''
        fs.WriteToFile("./math_log.py", script)
        result = `python3 ./math_log.py`
        `rm ./math_log.py`
        return result
    }

    static fn Log10(num) {
        # Use Python to calculate the base-10 logarithm of a number
        script = '''
import math

print(math.log10(''' + num + '''))
'''
        fs.WriteToFile("./math_log10.py", script)
        result = `python3 ./math_log10.py`
        `rm ./math_log10.py`
        return result
    }

    static fn Ceil(num) {
        # Use Python to round a number up to the nearest integer
        script = '''
