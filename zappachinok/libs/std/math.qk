## Math Library

import libs.zappachinok.libs.std.io
import libs.zappachinok.libs.std.fs

class Math {
    static fn Sqrt(num) {
        # Use Python to calculate the square root of a number
        script = '''
import math

try:
    print(math.sqrt(''' + num + '''))
except Exception as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./math_sqrt.py", script)
        result = `python3 ./math_sqrt.py`
        `rm ./math_sqrt.py`
        return result
    }

    static fn Pow(base, exponent) {
        # Use Python to calculate the power of a number
        script = '''
import math

try:
    print(math.pow(''' + base + ''', ''' + exponent + '''))
except Exception as e:
    print(f"Error: {e}")
'''
        fs.WriteToFile("./math_pow.py", script)
        result = `python3 ./math_pow.py`
        `rm ./math_pow.py`
        return result
    }

    static fn Abs(num) {
        # Use Python to calculate the absolute value of a number
        script = '''
print(abs(''' + num + '''))
'''
        fs.WriteToFile("./math_abs.py", script)
        result = `python3 ./math_abs.py`
        `rm ./math_abs.py`
        return result
    }

    static fn Sin(num) {
        # Use Python to calculate the sine of a number
        script = '''
import math

print(math.sin(''' + num + '''))
'''
        fs.WriteToFile("./math_sin.py", script)
        result = `python3 ./math_sin.py`
        `rm ./math_sin.py`
        return result
    }

    static fn Cos(num) {
        # Use Python to calculate the cosine of a number
