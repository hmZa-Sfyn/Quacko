'''
        fs.WriteToFile("./math_asin.py", script)
        result = `python3 ./math_asin.py`
        `rm ./math_asin.py`
        return result
    }

    static fn Acos(num) {
        # Use Python to calculate the arccosine of a number
        script = '''
